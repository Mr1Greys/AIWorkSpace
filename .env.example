# ================================
# DATABASE
# ================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aiworkspace
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aiworkspace

# ================================
# REDIS
# ================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ================================
# JWT
# ================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ================================
# OAUTH PROVIDERS
# ================================
# GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3001/auth/oauth/github/callback

# LinkedIn
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_CALLBACK_URL=http://localhost:3001/auth/oauth/linkedin/callback

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ================================
# BLOCKCHAIN
# ================================
# Base L2
BASE_RPC_URL=https://mainnet.base.org
BASE_CHAIN_ID=8453
ESCROW_ADDRESS=0x...
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Polygon (fallback)
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_CHAIN_ID=137

# Private key (for backend transactions)
PRIVATE_KEY=your-private-key-without-0x-prefix

# Arbiter address (Gnosis Safe recommended)
ARBITER_ADDRESS=0x...

# Alchemy / QuickNode
ALCHEMY_API_KEY=your-alchemy-api-key

# WalletConnect
WC_PROJECT_ID=your-walletconnect-project-id

# ================================
# AWS S3
# ================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET=aiworkspace-uploads
S3_ENDPOINT=https://s3.amazonaws.com

# ================================
# IPFS (Pinata)
# ================================
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_KEY=your-pinata-secret-key
IPFS_GATEWAY=https://gateway.pinata.cloud

# ================================
# OPENAI
# ================================
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# ================================
# EMAIL (Nodemailer)
# ================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@aiworkspace.io

# ================================
# PUSH NOTIFICATIONS (Firebase)
# ================================
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@...
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# ================================
# CLAMAV (Virus Scanner)
# ================================
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ================================
# SENTRY (Error Tracking)
# ================================
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=development

# ================================
# SECURITY
# ================================
# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://aiworkspace.io

# Encryption key (32 bytes hex)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# Rate limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# ================================
# APP CONFIGURATION
# ================================
NODE_ENV=development
API_PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Version
VERSION=1.0.0

# Logging
LOG_LEVEL=info

# ================================
# MONITORING
# ================================
# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3002
GRAFANA_ADMIN_PASSWORD=admin

# ================================
# STAGING / PRODUCTION
# ================================
# Override these in .env.staging and .env.production

# STAGING_DATABASE_URL=...
# PROD_DATABASE_URL=...

# STAGING_REDIS_URL=...
# PROD_REDIS_URL=...

# PROD_BASE_RPC_URL=...
# PROD_ESCROW_ADDRESS=...
